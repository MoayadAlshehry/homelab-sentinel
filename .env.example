# Homelab Sentinel Environment Variables Example
# Values will be populated in subsequent deployment stages.

# Service Port Mapping (Uncommon High Ports: 20000-59999)
PROMETHEUS_PORT=29090
NODE_EXPORTER_PORT=29100
GRAFANA_PORT=23000
UPTIME_KUMA_PORT=23001

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=change_this_password_in_production
